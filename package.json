{
  "name": "raven-pomodoro",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/desktop",
    "lint": "eslint .",
