{
  "name": "raven-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "A pixel-art desktop widget for running Pomodoro sessions",
  "author": "Jay Mirzaei",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --universal --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "auto-launch": "^5.0.6",
    "electron-store": "^8.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
